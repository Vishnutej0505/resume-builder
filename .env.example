# Copy to .env and fill in. Expo inlines any EXPO_PUBLIC_* variable into the
# JS bundle at build time — never put a real secret here (see ARCHITECTURE.md
# Section 5: the Gemini API key lives only in the Cloudflare Worker).

# The deployed Cloudflare Worker's URL (from `wrangler deploy` in worker/).
EXPO_PUBLIC_WORKER_URL=https://resume-builder-ai-proxy.<your-subdomain>.workers.dev

# Shared header value the Worker checks before calling Gemini. This is a
# scraping deterrent, not real security — it ships inside the APK and can be
# extracted by decompiling it (see ARCHITECTURE.md Section 5 and
# Vault/WIKI/Things To Avoid.md). Must match APP_SHARED_SECRET set on the
# Worker via `wrangler secret put APP_SHARED_SECRET`.
EXPO_PUBLIC_APP_SHARED_SECRET=
